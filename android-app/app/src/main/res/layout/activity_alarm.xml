<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#090d16">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⏰ WAKE UP ALARM"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#ef4444"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Solve the math challenge to stop the alarm!"
        android:textColor="#9ca3af"
        android:textSize="14sp"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tv_math_problem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="17 + 8 = ?"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#6366f1"
        android:gravity="center"
        android:padding="16dp"
        android:background="#111827"
        android:layout_marginBottom="20dp" />

    <EditText
        android:id="@+id/et_math_answer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter answer..."
        android:inputType="number"
        android:gravity="center"
        android:textSize="20sp"
        android:textColor="#ffffff"
        android:textColorHint="#6b7280"
        android:padding="14dp"
        android:background="#1f2937"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_submit_math"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Submit Answer"
            android:textColor="#ffffff"
            android:backgroundTint="#6366f1"
            android:padding="14dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_snooze"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Snooze (5m)"
            android:textColor="#ffffff"
            android:backgroundTint="#374151"
            android:padding="14dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
